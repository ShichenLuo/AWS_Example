

if [ -z "$1" ]; then
    echo "INPUT_DIR required"
fi

INPUT_DIR=$1
OUTPUT_DIR=$2
if [ -d $1 ]; then
    aws s3 sync $INPUT_DIR s3://$OUTPUT_DIR --profile myprofile --query Location --output text

elif [ -f $1 ]; then
    aws s3 cp $INPUT_DIR s3://$OUTPUT_DIR --profile myprofile --query Location --output text
fi