{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullAccessForSpecificUsers",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::ACCOUNT_ID_1:user/user1",
          "arn:aws:iam::ACCOUNT_ID_2:user/user2"
        ]
      },
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::my-example-lsc",
        "arn:aws:s3:::my-example-lsc/*"
      ]
    },
    {
      "Sid": "PublicReadAccess",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-example-lsc/*"
    }
  ]
}