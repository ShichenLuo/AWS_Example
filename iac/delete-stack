#delete stack: stack_name; region; 
stack_name=$1

if [ -z $2 ]; then
    region="us-east-1"
else
    region=$2
fi

echo "deleting stack $stack_name"

aws cloudformation delete-stack \
--stack-name $stack_name \
--region $region \
--profile myprofile

aws --no-cli-pager cloudformation list-stacks \
--query "StackSummaries[].[StackName, StackStatus]" \
--output table \
--profile myprofile \
--region "us-east-1"